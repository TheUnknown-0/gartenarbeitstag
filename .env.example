# Kopiere diese Datei nach .env und setze sichere Passwörter.
DB_ROOT_PASS=bitte_sicheres_root_passwort_setzen
DB_USER=gartenarbeitstag
DB_PASS=bitte_sicheres_passwort_setzen
DB_NAME=gartenarbeitstag
APP_PORT=9020
APP_ENV=production

# Verzeichnis, in dem die Anwendung liegt. "/" = eigene (Sub-)Domain.
BASE_URL=/

PMA_PORT=8091

# E-Mail-Versand (Erinnerungen an Standleitungen/Schueler:innen, Test-Mail).
# Leer lassen (MAIL_HOST leer) = Versand bleibt deaktiviert, Formulare zeigen
# einen Hinweis statt eines Fehlers.
MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS, meist Port 587) | ssl (implizites TLS, meist Port 465) | none
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Gartenarbeitstag

# Sekunden, die der Start auf die Datenbank wartet, bevor er aufgibt.
# Ohne Abbruch bliebe der Container endlos in der Warteschleife und gälte
# dabei als lauffähig; mit Abbruch greift die Restart-Policy.
DB_WAIT_TIMEOUT=120

# Adressen, denen der X-Forwarded-For-Header geglaubt wird — kommagetrennt,
# CIDR erlaubt. LEER LASSEN, wenn die Anwendung direkt erreichbar ist.
#
# Wichtig: Hier gehören ausschließlich die Adressen des eigenen Reverse-Proxys
# hinein, niemals ganze private Netze. Gilt ein ganzes Schulnetz als
# vertrauenswürdig, kann jeder Rechner darin seine Absenderadresse frei
# behaupten — und damit sämtliche IP-Grenzen (Login, Registrierung)
# umgehen und die Einträge im Audit-Log verfälschen.
# Beispiel: TRUSTED_PROXIES=10.1.2.3
TRUSTED_PROXIES=
