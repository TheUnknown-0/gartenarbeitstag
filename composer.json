{
    "name": "bso/gartenarbeitstag",
    "description": "Webanwendung zur Organisation des schulischen Gartenarbeitstags (Stände, Limits, Einschreibung)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-gd": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
